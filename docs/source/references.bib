@article{DERIDDER2027114796,
title = {Application of classical Density Functional theory for diffusion of gases confined in nanoporous materials},
journal = {Fluid Phase Equilibria},
volume = {611},
pages = {114796},
year = {2027},
issn = {0378-3812},
doi = {https://doi.org/10.1016/j.fluid.2026.114796},
author = {V. {De Ridder} and L. Vanduyfhuys},
keywords = {Classical density functional theory, Nanoporous materials, Confined fluid, Diffusion, Adsorption, Free energy profile, Diffusivity},
abstract = {A novel cDFT-based methodology is introduced for computing diffusivities of gases confined in nanoporous materials at a lower computational cost than enhanced sampling molecular dynamics. It is therefore envisioned to be particularly useful in high-throughput screening investigations. We showcase its application to small hydrocarbons in ZIF-8 and investigate the correlation of diffusion with gate-opening and chemical potential. This confirms the earlier reported gate opening phenomenon in ZIF-8, but also allows to quantify the magnitude with which the free energy barrier of diffusion decreases as the gate opens up. Furthermore, it also reveals that the barrier first goes down with increased chemical potential, but for ethane and ethene the barrier rises again due to clogging effects. This work establishes a fast and accurate methodology for studying diffusion in nanoporous materials, paving the way for high-throughput screening and the integration of advanced methods such as machine-learning potentials into these traditionally computationally intensive studies.}
}